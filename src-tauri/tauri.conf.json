{
  "$schema": "https://schema.tauri.app/v2/tauri/conf.json",
  "productName": "Phoenix Tekton",
  "version": "0.3.0",
  "identifier": "com.phoenixinceptionsmedia.tekton",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 6041",
    "devUrl": "http://localhost:6041",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Phoenix Tekton — Service Blueprint Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-nQgOLSpSOgmmajUGNU1U8xSTajLLfn8Vlzr+I9gryWU=' 'sha256-LoH1CwXANlvaEQC95A9w3sVLI/834f9vw8v/7dvOnPo='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' blueprint-preview: http://blueprint-preview.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "category": "Development",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}