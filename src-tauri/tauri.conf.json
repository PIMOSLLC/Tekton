{
  "$schema": "https://schema.tauri.app/v2/tauri/conf.json",
  "productName": "phoenix-tekton",
  "version": "0.1.0",
  "identifier": "com.phoenixinceptionsmedia.tekton",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 6041",
    "devUrl": "http://localhost:6041",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tekton — Service Blueprint Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "category": "Development",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}